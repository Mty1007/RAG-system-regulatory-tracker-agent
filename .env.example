# ============================================================
# Regulatory Tracker Agent — environment variable template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked <your-…>
#   3. Never paste real values into chat, PRs, or issues
#   4. .env is gitignored — it will never be committed
# ============================================================


# ── IBM Cloud Object Storage ─────────────────────────────────
# IAM API key for the COS service instance
COS_API_KEY=<your-cos-iam-api-key>

# Full CRN of the COS service instance
# Format: crn:v1:bluemix:public:cloud-object-storage:global:a/…::
COS_INSTANCE_CRN=<your-cos-instance-crn>

# Regional / direct endpoint (no trailing slash)
# e.g. https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_ENDPOINT=<your-cos-endpoint>

# Bucket that holds docs/, transformed/, pdfs/ prefixes
COS_BUCKET=<your-bucket-name>

# Optional: separate bucket for raw PDFs (defaults to COS_BUCKET if unset)
# COS_PDF_BUCKET=<your-pdf-bucket-name>


# ── watsonx Docling OCR (TextExtractionsV2) ─────────────────
# Connection asset ID for the COS bucket registered inside your watsonx project.
# Create it in watsonx.ai → Manage → Connections, then paste the asset ID here.
WATSONX_COS_CONNECTION_ASSET_ID=<your-watsonx-cos-connection-asset-id>


# ── AstraDB (IBM DataStax) ───────────────────────────────────
# Token from Astra console → your DB → Connect → Generate Token
# Format: AstraCS:…
ASTRA_DB_APPLICATION_TOKEN=<AstraCS:your-token-here>

# REST endpoint shown in Astra console → your DB → Connect
# Format: https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_API_ENDPOINT=<your-astra-endpoint>

# Keyspace / namespace to use (will be created if it does not exist)
ASTRA_DB_KEYSPACE=regulatory


# ── IBM WatsonX ──────────────────────────────────────────────
# Rotate your key at: IBM Cloud → Manage → Access (IAM) → API keys
WATSONX_API_KEY=<your-new-rotated-watsonx-api-key>

# Your WatsonX project ID (visible in WatsonX → Manage → General)
WATSONX_PROJECT_ID=<your-watsonx-project-id>

# WatsonX regional URL (no trailing slash)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Embedding model — used only for OCR pipeline (WatsonX TextExtractionsV2)
# Vector embeddings for RAG are generated by AstraDB via $vectorize (NVIDIA)
WATSONX_EMBED_MODEL=ibm/granite-embedding-278m-multilingual

# LLM for answer generation
WATSONX_LLM_MODEL=mistralai/mistral-medium-2505

# Reranker backend: "astradb" (built-in NVIDIA reranker, no extra API key needed)
# "watsonx" (WatsonX Rerank API) or "local" (sentence-transformers, no API call)
RERANKER=astradb


# ── Pipeline behaviour (optional overrides) ──────────────────
# Only process one source prefix: PCPD | SFC
# OCR_SOURCE=SFC

# Set to "1" to force re-chunking all docs even if already in AstraDB
# FORCE_RECHUNK=0

# Set to "1" to skip writing layout elements to AstraDB (dry-run)
# SKIP_LAYOUT_STORE=0

# Set to "1" to skip the chunk+embed step (dry-run)
# SKIP_CHUNK_STORE=0

# ── App mode ─────────────────────────────────────────────────
# Set to any non-empty value to use COS instead of in-memory store
# USE_COS=1


# ── Evaluation (optional) ────────────────────────────────────
# Path to the rolling RAG eval log written by every /chat request
# RAG_EVAL_LOG=rag_eval_log.csv

# Base URL of the running API — used by scripts/seed_eval_log.py
# API_BASE=http://127.0.0.1:8000
